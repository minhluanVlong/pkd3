rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Connection test document
    match /test/{docId} {
      allow read: if isValidId(docId);
    }

    // Validation for DailySchedule
    function isValidDailySchedule(data) {
      return data.keys().hasAll(['date', 'patients', 'sessions', 'totalPatients', 'updatedAt']) &&
             data.keys().hasOnly(['date', 'patients', 'sessions', 'totalPatients', 'updatedAt', 'updatedBy']) &&
             data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.patients is list && data.patients.size() <= 300 &&
             data.sessions is list && data.sessions.size() <= 1500 &&
             (data.totalPatients is int || data.totalPatients is float) && data.totalPatients >= 0 && data.totalPatients <= 2000 &&
             data.updatedAt is string && data.updatedAt.size() <= 100 &&
             (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128));
    }

    // Validation for DepartmentConfig
    function isValidDepartmentConfig(data) {
      return data.keys().hasAll(['machines', 'updatedAt']) &&
             data.keys().hasOnly(['machines', 'nurses', 'updatedAt', 'updatedBy']) &&
             data.machines is list && data.machines.size() <= 50 &&
             (!('nurses' in data) || (data.nurses is list && data.nurses.size() <= 20)) &&
             data.updatedAt is string && data.updatedAt.size() <= 100 &&
             (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128));
    }

    // Schedules collection
    match /schedules/{dateId} {
      allow get, list: if isValidId(dateId);
      allow create, update: if isValidId(dateId) &&
                               dateId == incoming().date &&
                               isValidDailySchedule(incoming());
      allow delete: if isValidId(dateId);
    }

    // Department settings collection
    match /settings/{settingId} {
      allow get, list: if isValidId(settingId);
      allow create, update: if isValidId(settingId) &&
                               settingId == 'department' &&
                               isValidDepartmentConfig(incoming());
      allow delete: if isValidId(settingId);
    }
  }
}
